        "text": {
          "primary": "#1e293b",
          "secondary": "#64748b",
          "light": "#94a3b8",
          "accent": "#7C3AED"
        },
        "accent": {
          "primary": "#7C3AED",
          "success": "#10B981",
          "danger": "#EF4444",
          "warning": "#fbbf24",
          "muted": "#64748B",
          "info": "#3b82f6"
        },
        "border": {
          "default": "rgba(0, 0, 0, 0.06)",
          "active": "rgba(124, 58, 237, 0.3)"
