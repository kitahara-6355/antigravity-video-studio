          "chart-1": "#7C3AED",
          "chart-2": "#10B981",
          "chart-3": "#3b82f6",
          "chart-4": "#EF4444",
          "chart-5": "#fbbf24",
          "slider-track": "#e2e8f0",
          "slider-fill": "#7C3AED",
          "theme-indigo": "#6366f1",
          "theme-indigo-light": "#a5b4fc",
          "theme-indigo-bg": "#eef2ff",
          "theme-indigo-dark": "#4338ca"
        }
      },
      "typography": {
        "font-heading": "'Outfit', 'Noto Sans JP', sans-serif",
        "font-body": "'Noto Sans JP', 'Inter', sans-serif",
        "font-serif": "'Noto Serif JP', serif",
        "size-h1": "1.8rem",
        "size-h2": "1.3rem",
        "size-h3": "1.1rem",
        "size-body": "1rem",
        "size-small": "0.85rem",
        "size-xs": "0.78rem",
        "weight-bold": "800",
        "weight-semibold": "700",
        "weight-medium": "600",
        "weight-normal": "400",
        "letter-spacing-tight": "-0.02em",
        "letter-spacing-wide": "0.04em",
        "line-height-body": "1.7"
      },
      "shadow": {
        "sm": "0 1px 3px rgba(0, 0, 0, 0.04)",
        "md": "0 2px 8px rgba(0, 0, 0, 0.06)",
        "lg": "0 8px 30px rgba(0, 0, 0, 0.1)",
        "glow": "0 4px 16px rgba(124, 58, 237, 0.15)",
