        "success-glow": "0 2px 12px rgba(16, 185, 129, 0.3)",
        "danger-glow": "0 4px 6px rgba(239, 68, 68, 0.3)"
      },
      "radius": {
        "sm": "8px",
        "md": "12px",
        "lg": "16px",
        "pill": "100px"
      },
      "motion": {
        "duration-fast": "0.15s",
        "duration-normal": "0.2s",
        "duration-slow": "0.3s",
        "easing-default": "ease",
        "easing-bounce": "cubic-bezier(0.175, 0.885, 0.32, 1.275)",
        "easing-smooth": "ease-in-out"
      }
    },
