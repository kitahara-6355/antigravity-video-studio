                "4. 必要に応じてtiers設定を更新",
                "5. deprecatedモデルの削除判断"
            ]
        },
        "sdk_compatibility_check": {
            "description": "起動時のSDK互換性自動チェック",
            "enabled": true,
            "fallback_on_incompatible": true
