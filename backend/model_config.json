    "evolution_strategy": {
        "description": "3段階入替方式 - 全カテゴリ統一",
        "principle": "上中下で世代を揃え、処理量と品質要求に応じて使い分け",
        "on_new_generation": {
            "text": [
                "1. 新世代ProをPremiumに設定",
                "2. 新世代FlashをStandardに設定",
                "3. 旧PremiumをBatchに降格",
                "4. 旧Batchをdeprecatedに移動"
            ],
            "image": [
