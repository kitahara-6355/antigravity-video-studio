{
    "version": "5.0.0",
    "last_updated": "2026-04-10",
    "architecture": "three_tier_complete",
    "description": "3段階方式。グレード方針: 後発・高性能・無料枠が限られるモデルを上位に配置し優先消費。安定版を中位で確保。",
    "grade_policy": {
        "principle": "後発モデルでより賢いもの、利用枠が少なく先に消費すべきモデルをPremiumに配置する",
        "premium": "最新世代・高性能・枠変動リスクあり → 優先消費",
        "standard": "安定版・信頼性重視 → 確実な処理に使用",
        "batch": "軽量版・大量処理 → コスト最適化"
    },
    "text_generation": {
        "default_model": "gemini-2.5-flash",
        "tiers": {
            "premium": {
                "model": "gemini-3-flash-preview",
                "label": "上 (Premium)",
                "description": "最新世代・最高性能 — 品質ゲート・最終判断・重要な意思決定",
                "preserve_ratio": 0.2,
                "note": "Gemini 3世代。後発かつ高性能、枠が限定的なため優先消費する",
                "use_cases": [
                    "quality_gate",
                    "director",
                    "brand_check",
                    "lightweight_scan",
                    "supervisor"
                ]
            },
            "standard": {
                "model": "gemini-2.5-flash",
                "label": "中 (Standard)",
                "description": "安定版 — 字幕・テロップ・AI確認・校閲の確実な処理",
                "preserve_ratio": 0.0,
                "note": "最も信頼性が高い安定モデル。確実な処理に使用",
                "use_cases": [
                    "subtitle",
                    "telop",
                    "ai_confirmation",
                    "proofreader"
                ]
            },
            "batch": {
                "model": "gemini-2.5-flash-lite",
                "label": "下 (Batch)",
                "description": "軽量版 — 大量処理・バッチ・事前分析",
                "preserve_ratio": 0.0,
                "note": "軽量版。大量処理・コスト最適化向け",
                "use_cases": [
                    "branding",
                    "semantic_chunker",
                    "bulk_processing",
                    "strategist"
                ]
            }
        },
        "fallback_chain": {
            "gemini-3-flash-preview": "gemini-2.5-flash",
            "gemini-2.5-flash": "gemini-2.5-flash-lite",
            "gemini-2.5-flash-lite": null
        }
    },
