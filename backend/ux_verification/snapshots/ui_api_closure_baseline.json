    "EventSource": "(?<![\\w.$])new\\s+EventSource\\s*\\(",
    "Service Worker": "serviceWorker\\s*\\.\\s*register\\s*\\(",
    "XMLHttpRequest": "(?<![\\w.$])new\\s+XMLHttpRequest\\s*\\(",
    "axios": "(?<![\\w.$])axios\\s*[.(]",
    "fetch": "(?<![\\w$])fetch\\s*(?:\\?\\.)?\\s*\\(",
    "fetch の別名束縛": "=\\s*(?:window|globalThis|self)?\\.?\\s*fetch\\s*(?![\\s(])",
    "fetch.call / fetch.apply": "(?<![\\w$])fetch\\s*\\.\\s*(?:call|apply|bind)\\s*\\(",
    "form action": "(?<![\\w$])(?:form)?[Aa]ction\\s*=\\s*[{'\\\"]",
    "location 遷移": "(?<![\\w$])(?:(?:window|globalThis|self|top|parent|document)\\s*\\.\\s*)?location\\s*(?:\\.\\s*(?:assign|replace)\\s*\\(|\\.\\s*href\\s*=(?!=)|=(?!=))",
    "new WebSocket": "(?<![\\w.$])new\\s+(?:(?:window|globalThis|self)\\s*\\.\\s*)?WebSocket\\s*\\(",
    "new Worker": "(?<![\\w.$])new\\s+(?:Shared)?Worker\\s*\\(",
    "object の data": "<object\\b[^>]*?\\bdata\\s*=\\s*[{'\\\"]",
    "sendBeacon": "(?<![\\w.$])navigator\\.sendBeacon\\s*\\(",
    "setAttribute で URL": "setAttribute\\s*\\(\\s*['\\\"](?:src|href|action|formaction|data|poster|srcset|content|ping)['\\\"]",
    "srcSet": "(?<![\\w$])srcSet\\s*=\\s*[{'\\\"]",
    "window.open": "(?<![\\w$])window\\.open\\s*\\(",
    "動的 import": "(?<![\\w.$])import\\s*\\(\\s*['\\\"`]",
    "素の open()": "(?<![\\w.$])open\\s*\\(\\s*['\\\"`]",
    "計算メンバでの fetch": "\\[\\s*['\\\"]fetch['\\\"]\\s*\\]"
