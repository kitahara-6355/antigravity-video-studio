[
{"start": 721.66, "end": 729.96, "sourceStart": 721.66, "sourceEnd": 729.96, "text": "ああ、なるほど。すごいですね。あとはその、色々先生有名な作品を描いてるんですけれども、例えば、ユニクロの"},
{"start": 1125.34, "end": 1130.06, "sourceStart": 1125.34, "sourceEnd": 1130.06, "text": "ええ。だ、逆に普段筆を持たない人に持ってもらって"},
{"start": 1251.24, "end": 1255.34, "sourceStart": 1251.24, "sourceEnd": 1255.34, "text": "とととと、はい。"},
{"start": 1516.46, "end": 1524.26, "sourceStart": 1516.46, "sourceEnd": 1524.26, "text": "アイデア出ししたり、プロット書いたり、こういう構成にしようってことを1週間のうち6日間費やすよ。"},
{"start": 1761.7, "end": 1768.7, "sourceStart": 1761.7, "sourceEnd": 1768.7, "text": "なんと、なん、なん"},
{"start": 1768.7, "end": 1775.1, "sourceStart": 1768.7, "sourceEnd": 1775.1, "text": "ま、なんか、あの美麗、プレゼント、プレゼント美麗さんが適当にこう、抽選してやってみて。"},
{"start": 1881.06, "end": 1883.36, "sourceStart": 1881.06, "sourceEnd": 1883.36, "text": "白いところがちょっと素敵すぎましたかね。"},
{"start": 1940.54, "end": 1952.46, "sourceStart": 1940.54, "sourceEnd": 1952.46, "text": "大、えっと何だっけ？えー、こんな感じで、5ページなんですね。えーと、デザイン書道講座"},
{"start": 1977.62, "end": 1981.62, "sourceStart": 1977.62, "sourceEnd": 1981.62, "text": "第1回目はなかったんですけど第1回めの時の課題これね"},
{"start": 2055.34, "end": 2056.54, "sourceStart": 2055.34, "sourceEnd": 2056.54, "text": "どうぞどうぞどうぞ。"},
{"start": 2088.52, "end": 2092.12, "sourceStart": 2088.52, "sourceEnd": 2092.12, "text": "うんと、横島は横島パンですか。"},
{"start": 2120.34, "end": 2124.54, "sourceStart": 2120.34, "sourceEnd": 2124.54, "text": "ここの海は大丈夫だと。もう、しけが荒れてきているけど、"},
{"start": 2219.06, "end": 2221.46, "sourceStart": 2219.06, "sourceEnd": 2221.46, "text": "ね。お魚の市場。うれしい口よ、これは。"},
{"start": 2313.94, "end": 2322.94, "sourceStart": 2313.94, "sourceEnd": 2322.94, "text": "これぐらい、まあ、前はこれぐらいの量で、例えば100本作れたんだがね、今は30本ぐらいしか作れないとか、その原毛の質まで悪くなっちゃって、"},
{"start": 2327.74, "end": 2334.64, "sourceStart": 2327.74, "sourceEnd": 2334.64, "text": "イタチにおいてはもう入ってこないのね。はい、今はいれないんだけど。"},
{"start": 2564.58, "end": 2569.08, "sourceStart": 2564.58, "sourceEnd": 2569.08, "text": "先生、去年初めてですね。"}
]
