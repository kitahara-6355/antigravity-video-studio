    "text": "思わなくて リレーショ"
  },
  {
    "start": 2.0,
    "end": 4.0,
    "text": "ン初めて来ていただいて"
  },
  {
    "start": 4.0,
    "end": 4.857142857142857,
    "text": "初めて来ましたか?"
  },
  {
    "start": 4.857142857142857,
    "end": 6.0,
    "text": "場所が分かりましたか?"
  },
  {
    "start": 6.0,
    "end": 8.0,
    "text": "場所が分かると、都加等の前で"
  },
  {
    "start": 8.0,
    "end": 10.0,
    "text": "なんです"
  },
  {
    "start": 10.0,
    "end": 12.4,
    "text": "今日は先生にいろんなこと"
  },
  {
    "start": 12.4,
    "end": 15.0,
    "text": "をお話し聞きたいんですけど"
  },
  {
    "start": 15.0,
    "end": 17.914285714285715,
    "text": "先生ラジオをやってらっしゃっていろ"
  },
  {
    "start": 17.914285714285715,
    "end": 21.0,
    "text": "んな医療のお話をされているんですけど"
  },
  {
    "start": 21.0,
    "end": 25.0,
    "text": "今日は真面目でない話も聞こうかなと"
  },
  {
    "start": 25.0,
    "end": 28.0,
    "text": "先生の人となりを探りたいので"
  },
  {
    "start": 28.0,
    "end": 30.0,
    "text": "お話しします"
  },
  {
    "start": 30.0,
    "end": 33.0,
    "text": "私ね、上野先生と知り合っ"
  },
  {
    "start": 33.0,
    "end": 36.0,
    "text": "て10年くらい立ちます?"
  },
  {
    "start": 36.0,
    "end": 38.0,
    "text": "そんなもん"
  },
  {
    "start": 38.0,
    "end": 39.89473684210526,
    "text": "それからもともと何"
  },
  {
    "start": 39.89473684210526,
    "end": 42.0,
    "text": "かの先生なんですか?"
  },
  {
    "start": 42.0,
    "end": 45.0,
    "text": "脳神経営化ですよね"
  },
  {
    "start": 45.0,
    "end": 50.0,
    "text": "すごい難しい分野だと思うんですけど"
  },
  {
    "start": 50.0,
    "end": 51.91304347826087,
    "text": "脳神経営化っていうのは"
  },
  {
    "start": 51.91304347826087,
    "end": 54.0,
    "text": "どんな病気が多いですか?"
  },
  {
    "start": 54.0,
    "end": 56.0,
    "text": "脳卒中"
  },
  {
    "start": 56.0,
    "end": 58.0,
